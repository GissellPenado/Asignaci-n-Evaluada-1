<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      prefHeight="650.0"
      prefWidth="900.0"
      spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tuempresa.actividadjavafx.PeliculasController">

    <padding>
        <Insets top="20"
                right="25"
                bottom="20"
                left="25"/>
    </padding>


    <Label text="REGISTRO DE PELÍCULAS">

        <font>
            <Font size="24.0"/>
        </font>

    </Label>


    <!-- FORMULARIO -->

    <HBox alignment="CENTER"
          spacing="10.0">

        <TextField fx:id="txtTitulo"
                   promptText="Título"
                   prefWidth="150.0"/>

        <TextField fx:id="txtDirector"
                   promptText="Director"
                   prefWidth="150.0"/>

        <TextField fx:id="txtGenero"
                   promptText="Género"
                   prefWidth="150.0"/>

        <TextField fx:id="txtAnio"
                   promptText="Año"
                   prefWidth="100.0"/>

        <TextField fx:id="txtDuracion"
                   promptText="Duración"
                   prefWidth="120.0"/>

    </HBox>


    <!-- BOTONES -->

    <HBox alignment="CENTER"
          spacing="15.0">

        <Button text="Limpiar campos"
                onAction="#limpiarCampos"
                prefWidth="140.0"/>

        <Button text="Procesar información"
                onAction="#procesarInformacion"
                prefWidth="170.0"/>

    </HBox>


    <Label text="Películas disponibles"/>


    <!-- TABLEVIEW -->

    <TableView fx:id="tablaPeliculas"
               prefHeight="400.0"
               prefWidth="850.0">

        <columns>

            <TableColumn fx:id="colTitulo"
                         text="Título"
                         prefWidth="180.0"/>

            <TableColumn fx:id="colDirector"
                         text="Director"
                         prefWidth="180.0"/>

            <TableColumn fx:id="colGenero"
                         text="Género"
                         prefWidth="150.0"/>

            <TableColumn fx:id="colAnio"
                         text="Año"
                         prefWidth="100.0"/>

            <TableColumn fx:id="colDuracion"
                         text="Duración"
                         prefWidth="120.0"/>

        </columns>

    </TableView>

</VBox>